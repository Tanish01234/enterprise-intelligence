# Enterprise Intelligence Platform - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Frontend (Next.js) - Public/Anon Keys Only
# These are safe to expose to the browser
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# Backend (FastAPI) - Includes Service Role Key
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (Supabase PostgreSQL)
# Format: postgresql://postgres:[password]@[host]:5432/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
JWT_EXPIRY=3600
JWT_ALGORITHM=HS256

# App
APP_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# AI / LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Market Data
MARKET_DATA_PATH=/data/market

# Feature Flags
ENABLE_BACKTESTING=true
ENABLE_AI_COPILOT=true
ENABLE_RETAIL_INTEL=true
ENABLE_ALERTS=false
ENABLE_FORECASTING=false

# Demo
DEMO_ORG_NAME=Demo Retail Co.
DEMO_ORG_SLUG=demo-retail-co
SEED_DATA_ENABLED=true